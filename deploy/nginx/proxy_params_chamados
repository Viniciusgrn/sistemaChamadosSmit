# Cabeçalhos que o Django precisa pra saber quem é o cliente de verdade.
# X-Forwarded-Proto alimenta o SECURE_PROXY_SSL_HEADER do settings: sem ele o
# Django acha que tudo é HTTP e monta URLs absolutas erradas atrás do TLS.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_redirect off;

proxy_connect_timeout 10s;
proxy_send_timeout    60s;
proxy_read_timeout    60s;
