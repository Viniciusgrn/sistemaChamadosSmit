# Copie para .env no servidor e preencha os três segredos. O .env NÃO vai pro git.
#
# Gere cada um direto no servidor (não reaproveite valores que passaram por
# chat, e-mail ou pelo repositório):
#   openssl rand -hex 32        # DJANGO_SECRET_KEY
#   openssl rand -hex 16        # DB_PASSWORD
#   openssl rand -hex 16        # DB_ROOT_PASSWORD

DJANGO_SECRET_KEY=

# Domínios/IPs pelos quais o sistema é acessado. Sem isso o Django devolve 400.
#
# O 127.0.0.1 é para o HEALTHCHECK do container, que bate em si mesmo pelo
# loopback: sem ele a sonda recebe 400 (DisallowedHost) e passa a dar como boa
# qualquer resposta, em vez de validar a aplicação de verdade.
DJANGO_ALLOWED_HOSTS=os.braganca.sp.gov.br,127.0.0.1

# Precisa do esquema. Só o domínio público: o acesso passa pelo nginx do host.
DJANGO_CSRF_TRUSTED_ORIGINS=https://os.braganca.sp.gov.br

# 0 até o certbot emitir o certificado; vire 1 logo depois. Ligado antes, o
# navegador descarta o cookie de sessão em HTTP e o login entra em loop.
DJANGO_HTTPS=0

# Porta no LOOPBACK onde o nginx do host encontra esta stack. Ela nunca é
# publicada na internet — confira que está livre com:  ss -lntp
HTTP_PORT=8003

DB_NAME=sistema_chamados
DB_USER=chamados
DB_PASSWORD=
DB_ROOT_PASSWORD=
