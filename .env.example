# Copie para .env na VPS e preencha os três segredos. O .env NÃO vai pro git.
#
# Gere cada segredo direto no servidor (não reaproveite valores que passaram por
# chat, e-mail ou pelo repositório):
#   openssl rand -base64 48        # DJANGO_SECRET_KEY
#   openssl rand -base64 24        # DB_PASSWORD
#   openssl rand -base64 24        # DB_ROOT_PASSWORD

DJANGO_SECRET_KEY=

# Domínios/IPs pelos quais o sistema é acessado. Sem isso o Django devolve 400.
# O 127.0.0.1 é para o HEALTHCHECK do container, que bate em si mesmo pelo
# loopback: sem ele a sonda recebe 400 (DisallowedHost) e passa a validar
# qualquer coisa em vez da aplicação de verdade.
DJANGO_ALLOWED_HOSTS=os.bragancapta.sp.gov.br,127.0.0.1

# Precisa do esquema. Só o domínio: o acesso público passa pelo nginx do host.
DJANGO_CSRF_TRUSTED_ORIGINS=https://os.bragancapta.sp.gov.br

# 0 até o certbot emitir o certificado; vire 1 logo depois.
DJANGO_HTTPS=0

# Porta no LOOPBACK onde o nginx do host encontra esta stack. Já ocupadas nesta
# VPS: 8000, 8001, 8002, 8080, 8085, 8086, 8087, 8088, 3002, 3306.
HTTP_PORT=8003

DB_NAME=sistema_chamados
DB_USER=chamados
DB_PASSWORD=
DB_ROOT_PASSWORD=
